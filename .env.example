# Telegram bot (from @BotFather)
BOT_TOKEN=
# Your own Telegram user ID (the only account the bot obeys)
OWNER_ID=
# Optional: other Telegram user IDs allowed to use the menu, comma-separated
ALLOWED_USER_IDS=

# Caller account (second Telegram account, from my.telegram.org). Optional:
# leave blank to run with bot messages only and no voice calls.
API_ID=
API_HASH=
CALLER_SESSION_PATH=data/caller.session

PRICE_URL=https://api.gold-api.com/price/BTC
POLL_INTERVAL_SEC=5
TIMEZONE=Asia/Kolkata
# Alerts only ring inside this window (local time, HH:MM). A target hit outside it
# sends one message instead of an alarm.
ALERT_WINDOW_START=05:30
ALERT_WINDOW_END=23:59
MAX_DEVIATION_PCT=30
MAX_ACTIVE_ALERTS=20
MSG_INTERVAL_SEC=5
CALL_RING_SEC=30
CALL_PAUSE_SEC=5
ALARM_TIMEOUT_SEC=120

# Healthchecks.io ping URL (optional locally)
HEALTHCHECK_URL=
DB_PATH=data/alerts.db
